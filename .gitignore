# =========================================================
# .gitignore · mars3d-vue-app（App 平板端项目）
# 结构：按产物类型分类，统一忽略项已并入对应分类
# =========================================================

# ---------- 编辑器+缓存+日志 相关 -----
/.vscode
/.cache
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/.idea
.history/
*.sublime-workspace


# ---------- 依赖 ----------
node_modules
package-lock.json
yarn.lock
/CesiumUnminified/
mars*d-*src.*
packages/mars3d/plugins/

# ---------- 构建与缓存产物 ----------
/dist
coverage/

# ---------- 环境变量与密钥（勿提交） ----------
.env
.env.local
.env.*.local
!.env.example

# ---------- App 离线打包产物（仅本地保留） ----------
pack/*.*
!pack/manifest.json
!pack/README.md
pack/assets
pack/config
pack/img
pack/mars3d-cesium
pack/cesium
pack/unpackage/cache
pack/unpackage/release
