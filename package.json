{
  "name": "mars3d-vue-app",
  "version": "3.11.0",
  "description": "在Vue3技术栈下的Mars3D平台 手机APP项目",
  "scripts": {
    "dev": "vite --host",
    "serve": "npm run clean-cache && vite --host",
    "clean-cache": "rimraf node_modules/.cache/ && rimraf node_modules/.vite",
    "clean-lib": "rimraf node_modules",
    "preview": "vite preview",
    "build": "npm run lint && vite build",
    "build2": "node --max_old_space_size=8192 ./node_modules/vite/bin/vite.js build",
    "build:app": "npm run lint && vite build --mode app",
    "serve:dist": "http-server ./dist",
    "lint": "vue-tsc --noEmit --skipLibCheck && npm run eslint",
    "eslint": "eslint ./src/**/*.{js,jsx,vue,ts,tsx} --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "type": "module",
  "dependencies": {
    "@icon-park/svg": "^1.4.2",
    "@turf/turf": "^7.4.0",
    "@vant/compat": "^1.0.1",
    "ali-oss": "^6.23.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "echarts": "^5.6.0",
    "font-awesome": "^4.7.0",
    "localforage": "^1.10.0",
    "lodash": "^4.18.1",
    "mars3d": "~3.11.8",
    "mars3d-cesium": "~1.146.0",
    "nprogress": "^0.2.0",
    "qs": "^6.16.0",
    "uuid": "^14.0.3",
    "vant": "^4.10.2",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/qs": "^6.15.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-vue": "^9.33.0",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.4",
    "http-server": "^14.1.1",
    "husky": "^9.1.7",
    "less": "^4.9.1",
    "lint-staged": "^16.4.0",
    "playwright": "^1.64.1",
    "postcss-px-to-viewport-8-plugin": "^1.2.5",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "standard": "^17.1.2",
    "terser": "^5.51.2",
    "typescript": "~6.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vconsole": "^3.15.1",
    "vite": "^8.3.4",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-mars3d": "^4.3.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.12"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marsgis/mars3d-vue-app.git"
  },
  "bugs": {
    "url": "https://github.com/marsgis/mars3d-vue-app/issues",
    "email": "wh@marsgis.cn"
  },
  "keywords": [
    "marsgis",
    "mars3d",
    "cesium",
    "vue",
    "vue3",
    "gis",
    "webgis"
  ],
  "author": "火星科技",
  "license": "Apache-2.0",
  "homepage": "http://mars3d.cn",
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "eslint --fix"
    ]
  }
}
